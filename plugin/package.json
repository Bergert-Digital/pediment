{
  "name": "pediment-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "wp-scripts start --webpack-src-dir=editor --output-path=build",
    "start:blocks": "WP_EXPERIMENTAL_MODULES=true wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks",
    "build:editor": "wp-scripts build --webpack-src-dir=editor --output-path=build",
    "build:blocks": "WP_EXPERIMENTAL_MODULES=true wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks && wp-scripts build-blocks-manifest --input=build/blocks --output=build/blocks-manifest.php",
    "build": "npm run build:editor && npm run build:blocks",
    "lint:js": "wp-scripts lint-js editor/ src/",
    "format": "wp-scripts format editor/ src/",
    "test:js": "wp-scripts test-unit-js",
    "e2e": "cd .. && plugin/node_modules/.bin/playwright test --config=plugin/playwright.config.ts --grep-invert @wpml",
    "e2e:wpml": "cd .. && plugin/node_modules/.bin/playwright test --config=plugin/playwright.config.ts --grep @wpml",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@playwright/test": "^1.45.0",
    "@wordpress/api-fetch": "^7.52.0",
    "@wordpress/block-editor": "^16.1.0",
    "@wordpress/blocks": "^15.25.0",
    "@wordpress/components": "^38.0.0",
    "@wordpress/compose": "^8.5.0",
    "@wordpress/data": "^10.52.0",
    "@wordpress/edit-post": "^8.52.0",
    "@wordpress/editor": "^14.52.0",
    "@wordpress/element": "^8.4.0",
    "@wordpress/env": "^10.0.0",
    "@wordpress/hooks": "^4.52.0",
    "@wordpress/i18n": "^6.25.0",
    "@wordpress/interactivity": "^6.52.0",
    "@wordpress/plugins": "^7.52.0",
    "@wordpress/rich-text": "^7.52.0",
    "@wordpress/scripts": "^34.0.0",
    "@wordpress/server-side-render": "^6.28.0",
    "typescript": "^5.4.0"
  }
}
