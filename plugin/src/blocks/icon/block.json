{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pediment/icon",
	"title": "Icon",
	"category": "pediment",
	"description": "One icon from the Pediment icon set; decorative, or announced to screen readers when it has a label.",
	"keywords": [ "icon", "symbol", "glyph" ],
	"textdomain": "pediment",
	"supports": { "html": false },
	"attributes": {
		"icon": { "type": "string", "default": "" },
		"label": { "type": "string", "default": "" }
	},
	"example": {
		"attributes": { "icon": "cube" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./style-index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
