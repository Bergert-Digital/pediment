{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Logo strip",
	"slug": "logos",
	"blockTypes": [ "core/group" ],
	"styles": {
		"css": "&>p{font-size:var(--wp--preset--font-size--sm);font-weight:600;letter-spacing:.04em;color:var(--wp--preset--color--foreground-muted)}& .wp-block-image{margin:0}& img{max-height:2rem;width:auto;opacity:.65;filter:grayscale(1);transition:opacity .15s ease,filter .15s ease}& img:hover{opacity:1;filter:none}"
	}
}
