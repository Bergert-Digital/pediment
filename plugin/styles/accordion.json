{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Accordion",
	"slug": "accordion",
	"blockTypes": [ "core/details" ],
	"styles": {
		"color": { "background": "var:preset|color|surface-elevated" },
		"border": { "radius": "var(--wp--custom--radius--md)", "width": "1px", "style": "solid", "color": "var:preset|color|border" },
		"spacing": { "padding": { "top": "var:preset|spacing|40", "right": "var:preset|spacing|50", "bottom": "var:preset|spacing|40", "left": "var:preset|spacing|50" } },
		"css": "&[open]{border-color:var(--wp--preset--color--border-strong);box-shadow:var(--wp--preset--shadow--subtle)}&>summary{font-weight:700;color:var(--wp--preset--color--foreground)}&[open]>summary{color:var(--wp--preset--color--accent-hover)}&>:not(summary){max-width:62ch;color:var(--wp--preset--color--foreground-muted)}"
	}
}
